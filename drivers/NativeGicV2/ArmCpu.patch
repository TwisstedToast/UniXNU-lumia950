+static gicv2::u32 gicV2Read (void *, gicv2::Space space, gicv2::u32 offset)
+{
+  const uintptr_t base = space == gicv2::Space::Distributor ? gDist : gFrames;
+  __asm__ volatile ("dsb sy" ::: "memory");
+  const uint32_t value = read32 (base, offset);
+  __asm__ volatile ("dsb sy" ::: "memory");
+  return value;
+}
+
+static void gicV2Write (void *, gicv2::Space space, gicv2::u32 offset, gicv2::u32 value)
+{
+  const uintptr_t base = space == gicv2::Space::Distributor ? gDist : gFrames;
+  __asm__ volatile ("dsb sy" ::: "memory");
+  write32 (base, offset, value);
+  __asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void gicV2Barrier (void *)
+{
+  __asm__ volatile ("dsb sy; isb" ::: "memory");
+}
