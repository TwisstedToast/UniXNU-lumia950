++static void
++save_regs(void)
++{
++	int cpuid = cpu_number();
++	__builtin_arm_dmb(DMB_ISH);
++	assert(ml_get_interrupts_enabled() == FALSE);
++	for (int i = 2; i < KPC_ARM64_PMC_COUNT; i++) {
++		saved_counter[cpuid][i] = read_counter(i);
