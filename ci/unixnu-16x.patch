++static bool
++kpc_cpu_callback(void * __unused param, enum cpu_event event,
++    unsigned int __unused cpu_or_cluster)
++{
++	if (!kpc_configured) {
++		return true;
++	}
++
++	switch (event) {
++	case CPU_BOOTED:
++		restore_regs();
++		break;
++
++	case CPU_DOWN:
++		save_regs();
++		break;
++
++	default:
++		break;
++	}
++	return true;
++}
